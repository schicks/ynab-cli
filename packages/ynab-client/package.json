{
  "name": "ynab-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/client.ts",
    "./testing": "./src/testing/tape.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --ignore-path=.oxignore src",
    "fmt": "oxfmt --ignore-path=.oxignore src",
    "fmt:check": "oxfmt --ignore-path=.oxignore --check src",
    "test": "bun test --pass-with-no-tests",
    "generate:types": "openapi-typescript openapi/ynab.yaml -o src/generated/ynab-openapi.d.ts",
    "check:generated": "bun run scripts/check-generated.ts"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0",
    "talkback": "^4.2.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0"
  }
}
